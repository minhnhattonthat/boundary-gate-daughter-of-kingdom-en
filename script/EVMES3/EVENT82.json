   "status": "",
   "notes": ""
  },
  {
   "id": "EVENT82:20c4d",
   "off": 134221,
   "op": "22",
   "group": "dialogue",
   "jp": "  境界の門を越えて\r  悪しき者来たり…",
   "en": "Across the Boundary Gate, a wicked one came...",
   "kind": "text",
   "status": "tl",
   "notes": ""
