   "off": 323621,
   "op": "22",
   "group": "dialogue",
   "jp": "大きな出世の手掛かりを    \rつかむために              ",
   "en": "Hoping to grab my big chance to rise in the world,",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
