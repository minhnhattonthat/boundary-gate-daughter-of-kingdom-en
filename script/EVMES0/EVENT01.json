   "off": 202654,
   "op": "22",
   "group": "dialogue",
   "jp": "  お願いします\r  妹に会えるまで\r  私を助けてください",
   "en": "Please... help me until I can see her.",
   "kind": "text",
   "status": "tl",
   "notes": ""
