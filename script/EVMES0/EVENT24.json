  {
   "id": "EVENT24:10ec6",
   "off": 69318,
   "op": "22",
   "group": "dialogue",
   "jp": "  父には伝えてある",
   "en": "to keep them confined at the manor.",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "EVENT24:10ede",
