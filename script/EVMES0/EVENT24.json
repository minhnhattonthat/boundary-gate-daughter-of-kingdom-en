   "status": "",
   "notes": ""
  },
  {
   "id": "EVENT24:10ee5",
   "off": 69349,
   "op": "22",
   "group": "dialogue",
   "jp": "  知識聖堂は いにしえの\r  知識を握っている",
   "en": "The Temple of Knowledge holds the Ancient Knowledge.",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "EVENT24:10f15",
   "off": 69397,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "EVENT24:10f1c",
   "off": 69404,
   "op": "22",
   "group": "dialogue",
   "jp": "  魔導聖堂でも簡単に手の\r  出せる相手ではない",
   "en": "Even the Temple of Sorcery cannot easily lay a hand on them.",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "EVENT24:10f4f",
   "off": 69455,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "EVENT24:10f56",
   "off": 69462,
   "op": "22",
   "group": "dialogue",
   "jp": "  知識聖堂の考えが\r  つかめないうちは\r  下手に動くな",
   "en": "Until we know what the Temple of Knowledge is thinking, make no rash moves.",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
