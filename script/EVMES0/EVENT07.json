   "group": "dialogue",
   "jp": "メルク\r「やっと 都から人が\r  来たようだね",
   "en": "Merk\r\"Well, somebody from the capital's finally come.",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "EVENT07:01242",
   "off": 4674,
   "op": "22",
