  },
  {
   "id": "MAPMES09:86bd1",
   "off": 551889,
   "op": "22",
   "group": "dialogue",
   "jp": "「坑道は立入禁止だ\u0010\b  穴から 化け物どもが\r  飛び出してきたんだ」\u0010",
   "en": "\"The mine's off-limits.\u0010\bMonsters came pourin' out of the shaft.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES09:86c20",
   "off": 551968,
   "op": "22",
   "group": "dialogue",
   "jp": "「作業用の非常口を使え\u0010\b  せまいから化け物も\r  出てこれまい」\u0010",
   "en": "\"Use the workers' emergency exit.\u0010\bIt's narrow, so the monsters can't get out that way.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES09:86c66",
   "off": 552038,
   "op": "22",
   "group": "dialogue",
   "jp": "「グリソムはどこに…」\u0010\b",
   "en": "\"Where's Grissom...\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES09:86c84",
