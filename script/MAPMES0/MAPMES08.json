   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES08:9854e",
   "off": 623950,
   "op": "22",
   "group": "dialogue",
   "jp": "アンブローズ城が見える\u0010",
   "en": "Ambrose Castle is in view.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES08:9856e",
   "off": 623982,
   "op": "22",
   "group": "dialogue",
   "jp": "貼り紙がある\u0010\r「反逆者に関する情報には\r  賞金をあたえる」\u0010",
   "en": "There's a notice.\u0010 \"A reward will be paid for information on rebels.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES08:985ac",
   "off": 624044,
   "op": "22",
   "group": "dialogue",
   "jp": "貼り紙がある\u0010\r「夜間 女性や子供は\r  出歩かないこと！」\u0010",
   "en": "There's a notice.\u0010 \"Women and children must not go out at night!\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES08:985e7",
   "off": 624103,
   "op": "22",
   "group": "dialogue",
   "jp": "貼り紙がある\u0010\r「あらたな増税については\r  おって発表する」\u0010",
   "en": "There's a notice.\u0010 \"Details of new taxes will be announced in due course.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES08:98625",
   "off": 624165,
   "op": "22",
   "group": "dialogue",
   "jp": "壁に落書きがある\u0010\r「増 税 反 対 ！」\u0010",
   "en": "There's graffiti on the wall.\u0010 \"NO MORE TAXES!\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES08:9864e",
