   "jp": "アンブローズ城が見える\u0010",
   "en": "Ambrose Castle is in view.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES01:97cdd",
   "off": 621789,
   "op": "22",
   "group": "dialogue",
   "jp": "番兵が居眠りしている\rようだ\u0010",
   "en": "The guard seems to be dozing.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES01:97cfc",
