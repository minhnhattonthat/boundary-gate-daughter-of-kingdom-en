   "op": "25",
   "group": "building",
   "jp": "治療院",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES01:97c7c",
   "off": 621692,
   "op": "22",
   "group": "dialogue",
   "jp": "大門は 閉ざされている\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES01:97c96",
   "off": 621718,
   "op": "22",
   "group": "dialogue",
   "jp": "西地区への門は\r閉ざされている\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES01:97cbb",
   "off": 621755,
   "op": "22",
   "group": "dialogue",
   "jp": "アンブローズ城が見える\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES01:97cdd",
   "off": 621789,
   "op": "22",
   "group": "dialogue",
   "jp": "番兵が居眠りしている\rようだ\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES01:97cfc",
   "off": 621820,
   "op": "23",
   "group": "location",
   "jp": "アンブローズ東地区",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES01:97d17",
   "off": 621847,
   "op": "22",
   "group": "dialogue",
   "jp": "カギが かかっている\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES01:97d32",
   "off": 621874,
   "op": "22",
   "group": "dialogue",
   "jp": "倉庫の床に蓋がしてある\u0010",
   "en": "",
