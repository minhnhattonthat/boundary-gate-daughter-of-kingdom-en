   "jp": "アンブローズ東地区",
   "en": "Ambrose East District",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES01:97d17",
   "off": 621847,
   "op": "22",
   "group": "dialogue",
   "jp": "カギが かかっている\u0010",
   "en": "It's locked.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES01:97d32",
