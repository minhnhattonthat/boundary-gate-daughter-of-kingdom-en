  {
   "id": "MAPMES14:89607",
   "off": 562695,
   "op": "23",
   "group": "location",
   "jp": "アンブローズ城西門",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89623",
   "off": 562723,
   "op": "21",
   "group": "speaker",
   "jp": "番兵\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:8962a",
   "off": 562730,
   "op": "22",
   "group": "dialogue",
   "jp": "「何をしている！\u0010\b  傭兵なら 軍の連絡所へ\r  行け」\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89664",
   "off": 562788,
   "op": "21",
   "group": "speaker",
   "jp": "兵士\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:8966b",
   "off": 562795,
   "op": "22",
   "group": "dialogue",
   "jp": "「軍の連絡所はここだ\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89683",
   "off": 562819,
   "op": "22",
   "group": "dialogue",
   "jp": "  しかし､傭兵の募集は\r  やっておらん！\u0010\b  今はそれどころじゃ\r  ないんだ！」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:896d3",
   "off": 562899,
   "op": "22",
   "group": "dialogue",
   "jp": "南地区への門は\r閉ざされている\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:896f7",
   "off": 562935,
   "op": "21",
   "group": "speaker",
   "jp": "乞食\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:8970e",
   "off": 562958,
   "op": "22",
   "group": "dialogue",
   "jp": "「旦那\u0010\b  きれいなお嬢さんと\r  ご一緒でどちらへ？\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89743",
   "off": 563011,
   "op": "22",
   "group": "dialogue",
   "jp": "  へへへ…\r  乞食には乞食の抜け道が\r  あるんでさあ\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89779",
   "off": 563065,
   "op": "22",
   "group": "dialogue",
   "jp": "  一緒のお嬢さんに免じて\r  ひとつだけ情報を\r  お教えしましょう\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:897bb",
   "off": 563131,
   "op": "22",
   "group": "dialogue",
   "jp": "  リオを信じることです\u0010\b  いずれ､この西地区に\r  あらわれるはず…\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:897ff",
   "off": 563199,
   "op": "22",
   "group": "dialogue",
   "jp": "  まあ､信じるも\r  信じないも旦那の\r  自由ですけどね」\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89841",
   "off": 563265,
   "op": "22",
   "group": "dialogue",
   "jp": "「お嬢さん､\u0017問題は自分で\r  解決するもんですよ」\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:8987f",
   "off": 563327,
   "op": "22",
   "group": "dialogue",
   "jp": "「プレリアール公の館は\r  アンブローズの北地区\u0010\b  の大門から行けるはず」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:898d4",
   "off": 563412,
   "op": "22",
   "group": "dialogue",
   "jp": "「マイヨールの息子が\r  行方不明らしい\u0010\b  そんな遠くには\r  行ってないじゃろう」\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89929",
   "off": 563497,
   "op": "22",
   "group": "dialogue",
   "jp": "「うまくいったようじゃの」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:8994a",
   "off": 563530,
   "op": "21",
   "group": "speaker",
   "jp": "老婆\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89951",
   "off": 563537,
   "op": "22",
   "group": "dialogue",
   "jp": "「城の横にそびえるのは\r  アンブローズの\u0010\b  大聖堂だよ\r\u0017  王国の娘の権威を\r  表すものだ\u0010\b  立派なもんだろ？」\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:899c5",
   "off": 563653,
   "op": "21",
   "group": "speaker",
   "jp": "男\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:899ca",
   "off": 563658,
   "op": "22",
   "group": "dialogue",
   "jp": "「軍のシンボルは\r  牙の紋章だ\u0010\b  軍隊を統率するのは\r  国王なのだが…」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89a17",
   "off": 563735,
   "op": "21",
   "group": "speaker",
   "jp": "老婆\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89a1e",
   "off": 563742,
   "op": "22",
   "group": "dialogue",
   "jp": "「検問のせいで街から\r  出るのも一苦労だよ\u0010\b  これじゃ 魔導聖堂の\r  クーデターじゃないか」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89a7f",
   "off": 563839,
   "op": "22",
   "group": "dialogue",
   "jp": "掲示板\r「本日の正午をもって\r  全軍の指揮権は\u0010\b  魔導聖堂に移される\r      －王国の娘－」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89ad9",
   "off": 563929,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89adc",
   "off": 563932,
   "op": "21",
   "group": "speaker",
   "jp": "掲示板の前の人々\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89aef",
   "off": 563951,
   "op": "22",
   "group": "dialogue",
   "jp": "「新国王は どこかに\r  幽閉されているらしい…\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89b1f",
   "off": 563999,
   "op": "22",
   "group": "dialogue",
   "jp": "  ワイズブルームの\r  知識聖堂は\r  なぜ黙っているんだ？」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89b5e",
   "off": 564062,
   "op": "21",
   "group": "speaker",
   "jp": "番兵\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES14:89b65",
   "off": 564069,
   "op": "22",
   "group": "dialogue",
   "jp": "「北地区への通行は\r  禁止されている」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  }
 ]
}
