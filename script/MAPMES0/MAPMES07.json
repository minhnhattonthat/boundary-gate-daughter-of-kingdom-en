  },
  {
   "id": "MAPMES07:7e176",
   "off": 516470,
   "op": "22",
   "group": "dialogue",
   "jp": "一瞬 リスプの顔が\rこわ張った\u0010\b",
   "en": "For an instant, Risp's face stiffened.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES07:7e1a6",
   "off": 516518,
   "op": "22",
   "group": "dialogue",
   "jp": "何もないようだ\u0010",
