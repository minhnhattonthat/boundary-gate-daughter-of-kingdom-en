  },
  {
   "id": "MAPMES07:7e0d5",
   "off": 516309,
   "op": "22",
   "group": "dialogue",
   "jp": "物陰に男が倒れている\u0010\bどうやら､怪我を\r負っているようだ\u0010\b",
   "en": "A man lay collapsed in the shadows.\u0010\bHe seemed to be injured.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES07:7e10f",
   "off": 516367,
   "op": "22",
   "group": "dialogue",
   "jp": "フィンは肩を貸し\r男の体を起こした\u0010\b",
   "en": "Finn lent him a shoulder and helped him up.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES07:7e136",
