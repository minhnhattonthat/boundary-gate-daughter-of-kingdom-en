   "notes": ""
  },
  {
   "id": "MAPMES07:7e139",
   "off": 516409,
   "op": "22",
   "group": "dialogue",
   "jp": "トールマンは手に持った\rねじれた金属片を リスプに\r見せた\u0010",
   "en": "Tallman showed Risp the twisted metal fragment in his hand.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
