  {
   "id": "MAPMES00:aae82",
   "off": 700034,
   "op": "22",
   "group": "dialogue",
   "jp": "「反逆者狩りをやっている\u0010\b  通行証がなければ\r  勝手に町から出ては\r  いかん！」\u0010",
   "en": "\"We're hunting rebels.\u0010\bNobody leaves town without a pass!\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES00:aaed9",
   "off": 700121,
   "op": "21",
   "group": "speaker",
   "jp": "番兵Ａ\r",
   "en": "Guard A\r",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES00:aaee2",
   "off": 700130,
   "op": "22",
   "group": "dialogue",
   "jp": "「今､反逆者の狩り出しを\r  行っている\u0010\b  この地区から移動しては\r  いかん！」\u0010\b\u0017",
   "en": "\"We're rounding up rebels right now.\u0010\bYou may not leave this district!\"\u0010\b\u0017",
