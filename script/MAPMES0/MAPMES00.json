   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES00:aafb0",
   "off": 700336,
   "op": "22",
   "group": "dialogue",
   "jp": "「今 反逆者の狩り出しを\r  行っている\u0010\b  この地区から移動しては\r  いかん！」\u0010\b\u0017",
