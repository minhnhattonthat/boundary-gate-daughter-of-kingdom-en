  },
  {
   "id": "EVENT33:0ff9a",
   "off": 65434,
   "op": "22",
   "group": "dialogue",
   "jp": "正直いって なんのことやら\r俺にはわからん…",
   "en": "honestly, I had no idea what she was talking about...",
   "kind": "text",
   "status": "tl",
   "notes": ""
