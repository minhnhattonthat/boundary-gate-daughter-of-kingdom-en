   "op": "22",
   "group": "dialogue",
   "jp": "さっきまで 泣いていた\rらしい\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "ROOMES31:21700",
   "off": 136960,
   "op": "22",
   "group": "dialogue",
   "jp": "グリソムに会いに来たこと\rを告げると 泣き出して\rしまった\u0010",
   "en": "",
