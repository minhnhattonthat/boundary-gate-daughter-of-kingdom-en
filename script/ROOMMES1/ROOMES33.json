   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "ROOMES33:4910a",
   "off": 299274,
   "op": "22",
   "group": "dialogue",
   "jp": "「リオの手当ては我々に\r  まかせてくれ」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
