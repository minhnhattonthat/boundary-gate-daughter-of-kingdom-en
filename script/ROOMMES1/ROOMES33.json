   "notes": ""
  },
  {
   "id": "ROOMES33:4913a",
   "off": 299322,
   "op": "22",
   "group": "dialogue",
   "jp": "司祭長がリスプに言った\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "ROOMES33:49156",
   "off": 299350,
   "op": "21",
   "group": "speaker",
   "jp": "魔導聖堂長\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "ROOMES33:49163",
   "off": 299363,
   "op": "22",
   "group": "dialogue",
   "jp": "「４つの迷宮の底で真実と\r  向かい合うのじゃ」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
