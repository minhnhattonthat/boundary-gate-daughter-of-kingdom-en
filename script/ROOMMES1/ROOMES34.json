  {
   "id": "ROOMES34:14794",
   "off": 83860,
   "op": "22",
   "group": "dialogue",
   "jp": "「うちは上等の品ばかりだ\r  少し値が張るがな」\u0010\b",
   "en": "\"Only top-quality goods here. They cost a bit more, mind.\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES34:147c8",
   "off": 83912,
   "op": "22",
   "group": "dialogue",
   "jp": "「こんな状態のおかげで\r  品がなくなりそうだよ」\u0010\b",
   "en": "\"With things the way they are, I'm about to run out of stock.\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES34:14801",
   "off": 83969,
   "op": "22",
   "group": "dialogue",
   "jp": "さて どんな御用ですか？",
   "en": "Now, what can I do for you?",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES34:14834",
   "off": 84020,
   "op": "22",
   "group": "dialogue",
   "jp": "「エルシノア湖を渡るなら\r  トーナムから\r  船に乗らなきゃな」\u0010",
   "en": "\"If you want to cross Lake Elsinore, you'll need to take a boat from Tornam.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES34:14877",
   "off": 84087,
   "op": "22",
   "group": "dialogue",
   "jp": "「王国の娘の姿をみたこと\r  あるかい？\u0010\b  遠くからだったけど\r  本当にきれいだったぜ」\u0010",
   "en": "\"Ever laid eyes on the Daughter of the Kingdom?\u0010\bI only saw her from far off, but she was a real beauty.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  }
 ]
