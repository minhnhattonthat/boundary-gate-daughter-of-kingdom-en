   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "ROOMES13:500d9",
   "off": 327897,
   "op": "22",
   "group": "dialogue",
   "jp": "「正面から行っても\r  入れてはくれまい\u0010\b  要塞に続く階段があった\r  はずじゃが…」\u0010",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "ROOMES13:50136",
   "off": 327990,
   "op": "21",
   "group": "speaker",
   "jp": "マイヨール\r",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "ROOMES13:50143",
   "off": 328003,
   "op": "22",
   "group": "dialogue",
   "jp": "「すっかり 明るくなって\r  しまったわい\u0010\b  舟が必要なら いつでも\r  きなさい」\u0010",
   "en": "",
