  },
  {
   "id": "ROOMES18:144a2",
   "off": 83106,
   "op": "22",
   "group": "dialogue",
   "jp": "「地下街のほとんどは\r  崩れてるけど クレーター\r  に続いているらしい」\u0010",
   "en": "\"Most of the underground town has caved in, but they say it leads to the crater.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES18:144ec",
   "off": 83180,
   "op": "22",
   "group": "dialogue",
   "jp": "「ひとり 元気な男の人が\r  いたんですけど…\u0010\b",
   "en": "\"There was one man who was still in good shape...\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES18:1451a",
   "off": 83226,
   "op": "22",
   "group": "dialogue",
   "jp": "  爆発の原因を調べるって\r  穴の内側にいったきり\r  戻ってこないんです」\u0010",
   "en": "He went into the crater to find out what caused the blast, and he never came back.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  }
 ]
