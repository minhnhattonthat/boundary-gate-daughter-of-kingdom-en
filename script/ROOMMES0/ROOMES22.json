  {
   "id": "ROOMES22:11b6f",
   "off": 72559,
   "op": "22",
   "group": "dialogue",
   "jp": "誰もいないようだ\u0010",
   "en": "No one seems to be here.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES22:11b8d",
   "off": 72589,
   "op": "22",
   "group": "dialogue",
   "jp": "「リオ？ \u0017あの男なら\r  もう､出てったよ」\u0010",
   "en": "\"Rio? \u0017That fella's already left.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES22:11bbb",
   "off": 72635,
   "op": "22",
   "group": "dialogue",
   "jp": "「いらっしゃい」\u0010",
   "en": "\"Welcome.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES22:11bd0",
   "off": 72656,
   "op": "22",
   "group": "dialogue",
   "jp": "「魔導聖堂に反抗すると\r  たちまち 処刑されちまう\r  って」\u0010",
   "en": "\"They say if you defy the Temple of Sorcery, you get executed on the spot.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "ROOMES22:11c0e",
   "off": 72718,
   "op": "22",
   "group": "dialogue",
   "jp": "「五芒星の紋章は\r  魔導聖堂の印だ\u0010\b  魔導聖堂は､王国内の魔力\r  を研究､管理する役割を\r  持っている」\u0010",
   "en": "\"The Pentagram Crest is the mark of the Temple of Sorcery.\u0010\bThe Temple of Sorcery's role is to study and govern the magical power within the kingdom.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  }
 ]
