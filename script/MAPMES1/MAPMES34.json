   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES34:a6f54",
   "off": 683860,
   "op": "22",
   "group": "dialogue",
   "jp": "乞食は リスプに\r『瞳の印の鍵』を手渡した\u0010\b",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
