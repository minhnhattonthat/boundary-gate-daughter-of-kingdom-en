 "entries": [
  {
   "id": "MAPMES37:93f6d",
   "off": 606061,
   "op": "22",
   "group": "dialogue",
   "jp": "リスプは 散らばった書類の\rタイトルに目を通した\u0010\b",
   "en": "Risp looked over the titles of the scattered papers.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:93fa1",
   "off": 606113,
   "op": "21",
   "group": "speaker",
   "jp": "リスプ\r",
   "en": "Risp\r",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:93faa",
   "off": 606122,
   "op": "22",
   "group": "dialogue",
   "jp": "「中枢神経系の構築と\r  制御に関する問題点」\u0010\b「効率的組織培養における\r  魔法技術の応用」\u0010\b「人工生命体による軍事組織\r  の構成」\u0010\b",
   "en": "\"Central Nervous System Design and Control\"\u0010\b\"Applying Magical Technique to Efficient Tissue Culture\"\u0010\b\"Forming a Military Organisation of Artificial Lifeforms\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:9402d",
   "off": 606253,
   "op": "22",
   "group": "dialogue",
   "jp": "「………」\u0010\b",
   "en": "\"...\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:9403e",
   "off": 606270,
   "op": "21",
   "group": "speaker",
   "jp": "メリッサ\r",
   "en": "Melissa\r",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94049",
   "off": 606281,
   "op": "22",
   "group": "dialogue",
   "jp": "「よくわからないけどさ\u0010\b  つまり 化け物の軍隊を\r  作ろうとしてたわけ？」\u0010\b",
   "en": "\"I don't really get it, but...\u0010\bbasically, they were trying to build an army of monsters?\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94096",
   "off": 606358,
   "op": "22",
   "group": "dialogue",
   "jp": "メリッサが足元の書類を\r蹴飛ばした\u0010\b",
   "en": "Melissa kicked away the papers at her feet.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:940bb",
   "off": 606395,
   "op": "22",
   "group": "dialogue",
   "jp": "フィンが机の中から\r山羊の印の鍵を見つけた\u0010\b",
   "en": "Finn found the Goat Key in the desk.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:940ea",
   "off": 606442,
   "op": "21",
   "group": "speaker",
   "jp": "メリッサ\r",
   "en": "Melissa\r",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:940f5",
   "off": 606453,
   "op": "22",
   "group": "dialogue",
   "jp": "「そういえば､\r  この山羊の紋章…\u0010\b  どこかで見たような」\u0010\b",
   "en": "\"Come to think of it, this goat crest...\u0010\bI've seen it somewhere before.\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94132",
   "off": 606514,
   "op": "22",
   "group": "dialogue",
   "jp": "山羊の印の鍵を\r手に入れた\u0010\b",
   "en": "Obtained the Goat Key.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94159",
   "off": 606553,
   "op": "22",
   "group": "dialogue",
   "jp": "何もないようだ\u0010",
   "en": "There seems to be nothing here.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94182",
   "off": 606594,
   "op": "22",
   "group": "dialogue",
   "jp": "突然､モンスターが\rあらわれた！\u0010",
   "en": "Suddenly, a monster appeared!\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:941a3",
   "off": 606627,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES37:941a9",
   "off": 606633,
   "op": "22",
   "group": "dialogue",
   "jp": "散らばった書類の中に\r老人が倒れている\u0010\b",
   "en": "An old man lies collapsed among the scattered papers.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:941d2",
   "off": 606674,
   "op": "22",
   "group": "dialogue",
   "jp": "リスプが駆け寄り 老人の\r頭を抱き上げた\u0010\b",
   "en": "Risp ran to him and cradled the old man's head.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:941fe",
   "off": 606718,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES37:94201",
   "off": 606721,
   "op": "22",
   "group": "dialogue",
   "jp": "老人にはリスプがわからな\rいようだ\u0010\b",
   "en": "The old man didn't seem to recognise Risp.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94226",
   "off": 606758,
   "op": "22",
   "group": "dialogue",
   "jp": "突然 リスプはよろいを\rはずすとシャツを脱いだ\u0010",
   "en": "Suddenly, Risp took off her armour and removed her shirt.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94255",
   "off": 606805,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES37:9425a",
   "off": 606810,
   "op": "22",
   "group": "dialogue",
   "jp": "胸の傷を見て 老人は気が\rついたようだ\u0010\b",
   "en": "Seeing the scar on her chest, the old man seemed to know her.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94284",
   "off": 606852,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES37:94287",
   "off": 606855,
   "op": "22",
   "group": "dialogue",
   "jp": "うつ向いたリスプの肩が\r震えている\u0010",
   "en": "Risp hung her head, her shoulders trembling.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:942ab",
   "off": 606891,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES37:942ae",
   "off": 606894,
   "op": "22",
   "group": "dialogue",
   "jp": "フィンとグレイストーンの\r耳をメリッサが引っ張った\u0010\b",
   "en": "Melissa dragged Finn and Greystone away by the ears.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:942e5",
   "off": 606949,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES37:942e8",
   "off": 606952,
   "op": "22",
   "group": "dialogue",
   "jp": "メリッサがグレイストーン\rの足を 思い切り蹴飛ばした\u0010",
   "en": "Melissa kicked Greystone in the shin as hard as she could.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:9431d",
   "off": 607005,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES37:94320",
   "off": 607008,
   "op": "22",
   "group": "dialogue",
   "jp": "リスプが戻ってきた\u0010",
   "en": "Risp came back.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94335",
   "off": 607029,
   "op": "22",
   "group": "dialogue",
   "jp": "涙を拭いながら\rひとつの鍵を差し出した\u0010\b",
   "en": "Wiping away her tears, she held out a key.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94362",
   "off": 607074,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES37:94365",
   "off": 607077,
   "op": "22",
   "group": "dialogue",
   "jp": "リスプは\r心臓の紋章の鍵を\r手に入れた\u0010",
   "en": "Risp obtained the Heart Crest Key.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
