   "notes": ""
  },
  {
   "id": "MAPMES37:9444c",
   "off": 607308,
   "op": "22",
   "group": "dialogue",
   "jp": "グレイストーンは扉を壊して\r中に踏み込んだ\u0010\b",
   "en": "Greystone broke down the door and stormed in.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94479",
   "off": 607353,
   "op": "22",
   "group": "dialogue",
   "jp": "巨大なガラスのタンクが\r並んでいる\u0010\b",
   "en": "Huge glass tanks stand in rows.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:9449e",
   "off": 607390,
   "op": "22",
   "group": "dialogue",
   "jp": "腐ったような悪臭が\rたちこめている\u0010\b",
   "en": "A rotten stench hangs in the air.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:944c3",
   "off": 607427,
   "op": "22",
   "group": "dialogue",
   "jp": "タンクの中には大きな生物\rが浮んでいる\u0010\b",
   "en": "Large creatures float inside the tanks.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:944ec",
   "off": 607468,
   "op": "22",
   "group": "dialogue",
   "jp": "中にはドロドロに溶けて\rしまっているものもある\u0010\b",
   "en": "Some of them have melted down into sludge.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:9451f",
   "off": 607519,
   "op": "21",
   "group": "speaker",
   "jp": "フィン\r",
   "en": "Finn\r",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES37:94528",
   "off": 607528,
   "op": "22",
   "group": "dialogue",
   "jp": "「北地区で見た化け物だ…」\u0010\b",
   "en": "\"The monsters we saw in the North District...\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
