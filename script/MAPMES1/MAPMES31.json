   "off": 474328,
   "op": "22",
   "group": "dialogue",
   "jp": "女は 思いきり壁をけとばし\rはずみで自分も\rひっくり返った\u0010\b",
   "en": "The woman kicked the wall as hard as she could, and the recoil sent her tumbling over.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES31:73d13",
   "off": 474387,
   "op": "22",
   "group": "dialogue",
   "jp": "壁が開き 上に続く階段が\rあらわれた\u0010",
   "en": "The wall slid open, revealing a staircase leading up.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES31:73d67",
   "off": 474471,
   "op": "22",
   "group": "dialogue",
   "jp": "牢の中で若い男が叫んだ\u0010\b",
   "en": "A young man in a cell cried out.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
