   "status": "",
   "notes": ""
  },
  {
   "id": "MAPMES31:73b12",
   "off": 473874,
   "op": "22",
   "group": "dialogue",
   "jp": "女は おもいっきり\r鉄格子を蹴飛ばし はずみで\r自分もひっくりかえった\u0010",
   "en": "The woman gave the bars an almighty kick, and the recoil knocked her flat on her back.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES31:73b57",
