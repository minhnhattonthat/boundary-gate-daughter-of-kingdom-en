   "notes": ""
  },
  {
   "id": "MAPMES35:99e08",
   "off": 630280,
   "op": "22",
   "group": "dialogue",
   "jp": "「？\r  誰かが倒れているわ」\u0010\b",
   "en": "\"Hm? Somebody's collapsed over there.\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99e2a",
   "off": 630314,
   "op": "21",
   "group": "speaker",
   "jp": "フィン\r",
   "en": "Finn\r",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99e33",
   "off": 630323,
   "op": "22",
   "group": "dialogue",
   "jp": "「リオだ！ おい！\r  だいじょうぶか！」\u0010\b",
   "en": "\"It's Rio! Hey! You all right?!\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99e60",
   "off": 630368,
   "op": "21",
   "group": "speaker",
   "jp": "リスプ\r",
   "en": "Risp\r",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99e69",
   "off": 630377,
   "op": "22",
   "group": "dialogue",
   "jp": "「！\u0017 フィン！\r  近づいちゃだめよ！\u0010\b  魔物が！」\u0010\b",
   "en": "\"Ah!\u0017 Finn! Don't get close!\u0010\bThere's a monster!\"\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99ea7",
   "off": 630439,
   "op": "22",
   "group": "dialogue",
   "jp": "リオは意識がないようだ\u0010\bグレイストーンが\rリオの身体を軽々と\r担ぎ上げた\u0010\b",
   "en": "Rio seemed to be unconscious.\u0010\bGreystone hoisted Rio onto his shoulder with ease.\u0010\b",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99ef3",
   "off": 630515,
   "op": "21",
   "group": "speaker",
   "jp": "グレイストーン\r",
   "en": "Greystone\r",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99f04",
   "off": 630532,
   "op": "22",
   "group": "dialogue",
   "jp": "「早く宿に連れて帰ろう」\u0010",
   "en": "\"Back to the inn. Quickly.\"\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99f49",
   "off": 630601,
   "op": "22",
   "group": "dialogue",
   "jp": "フィンが銀の鍵を使って\r落とし蓋の錠をはずした\u0010\bグレイストーンが重い落し\r蓋を軽々と引き上げた\u0010\b真っ暗な口を開けている\r穴に入った\u0010",
   "en": "Finn used the Silver Key to undo the lock on the trapdoor.\u0010\bGreystone hauled the heavy trapdoor up with ease.\u0010\bThey climbed down into the gaping black hole.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99fe3",
   "off": 630755,
   "op": "22",
   "group": "dialogue",
   "jp": "カギが かかっている\u0010",
   "en": "It's locked.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  }
 ]
