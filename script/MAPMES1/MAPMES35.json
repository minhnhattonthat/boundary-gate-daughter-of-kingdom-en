  },
  {
   "id": "MAPMES35:99dbe",
   "off": 630206,
   "op": "23",
   "group": "location",
   "jp": "アンブローズ南地区",
   "en": "Ambrose South District",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99dd9",
   "off": 630233,
   "op": "22",
   "group": "dialogue",
   "jp": "扉が壊れてるらしく\r入れない\u0010",
   "en": "The door seems to be broken. Can't get in.\u0010",
   "kind": "text",
   "status": "tl",
   "notes": ""
  },
  {
   "id": "MAPMES35:99dfd",
