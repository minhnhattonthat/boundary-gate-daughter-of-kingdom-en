  {
   "id": "EVENT69:23acf",
   "off": 146127,
   "op": "22",
   "group": "dialogue",
   "jp": "  知識聖堂を黙って\r  出てきたこと､隠して\r  いてごめんなさい…",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
