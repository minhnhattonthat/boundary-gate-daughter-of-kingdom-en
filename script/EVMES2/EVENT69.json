   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "EVENT69:23b15",
   "off": 146197,
   "op": "22",
   "group": "dialogue",
   "jp": "  私 キラルが苦しんで\r  いるのを感じて\r  我慢できなくて",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
