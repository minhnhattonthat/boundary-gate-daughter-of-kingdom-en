   "status": "",
   "notes": ""
  },
  {
   "id": "EVENT69:23b87",
   "off": 146311,
   "op": "22",
   "group": "dialogue",
   "jp": "  今まで､本当に\r  ありがとう…」",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
