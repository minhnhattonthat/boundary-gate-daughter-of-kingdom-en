   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
   "kind": "data",
   "status": "",
   "notes": ""
  },
  {
   "id": "EVENT69:23b55",
   "off": 146261,
   "op": "22",
   "group": "dialogue",
   "jp": "  でも 代金は約束通り\r  聖堂が 支払います",
   "en": "",
   "kind": "text",
   "status": "",
   "notes": ""
  },
  {
   "id": "EVENT69:23b84",
   "off": 146308,
   "op": "22",
   "group": "dialogue",
   "jp": "\b",
   "en": "",
